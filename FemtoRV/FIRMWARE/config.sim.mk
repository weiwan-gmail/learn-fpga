# Default firmware flags for Verilator / Icarus of the teaching SoC
# (FROM_BLINKER_TO_RISCV/step20.v is RV32I). Used when FIRMWARE/config.mk
# has not been generated by a board's `make <BOARD>.firmware_config`.
# Board builds still overwrite config.mk; do not use this file for FPGA.

ARCH=rv32i
ABI=ilp32
OPTIMIZE=-Os
DEVICES=
RAM_SIZE=6144
BOARD=sim
